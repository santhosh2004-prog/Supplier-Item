<mvc:View
    controllerName="supplieropenitems.controller.Begin"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        id="beginPage"
        title="Reconciliation Categories"
        showHeader="true"
        busy="{recon>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- ═══ Summary (All Categories) ═══ -->
                <VBox class="sapUiSmallMarginBottom">
                    <Text
                        text="Summary (All Categories)"
                        bold="true"
                    />
                    <VBox class="sapUiTinyMarginTop">
                        <HBox justifyContent="SpaceBetween">
                            <Text text="Invoice Amount" />
                            <Title
                                text="{ path: 'recon>/totals/InvAmt', formatter: '.formatAmount' }"
                                level="H6"
                            />
                        </HBox>
                        <HBox
                            justifyContent="SpaceBetween"
                            class="sapUiTinyMarginTop"
                        >
                            <Text text="Advance Amount" />
                            <Title
                                text="{ path: 'recon>/totals/AdvAmt', formatter: '.formatAmount' }"
                                level="H6"
                            />
                        </HBox>
                        <HBox
                            justifyContent="SpaceBetween"
                            class="sapUiTinyMarginTop"
                        >
                            <Text text="Net Amount" />
                            <Title
                                text="{
                                    parts: [
                                        { path: 'recon>/totals/InvAmt' },
                                        { path: 'recon>/totals/AdvAmt' }
                                    ],
                                    formatter: '.formatNetAmount'
                                }"
                                level="H6"
                            />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ═══ Category List — icon + name only ═══ -->
                <List
                    id="reconList"
                    items="{recon>/items}"
                    mode="None"
                    growing="true"
                    growingThreshold="7"
                    growingScrollToLoad="false"
                    growingTriggerText="View All Categories"
                    noDataText="Press Go to load categories"
                >
                    <CustomListItem
                        type="Navigation"
                        press=".onReconPress"
                    >
                        <HBox
                            alignItems="Center"
                            class="sapUiSmallMargin"
                        >
                            <Avatar
                                src="{ path: 'recon>Txt50', formatter: '.formatCategoryIcon' }"
                                displayShape="Square"
                                displaySize="S"
                                backgroundColor="{ path: 'recon>Txt50', formatter: '.formatCategoryColor' }"
                                class="sapUiTinyMarginEnd"
                            />
                            <Title
                                text="{ path: 'recon>Txt50', formatter: '.formatCategory' }"
                                level="H4"
                                wrapping="true"
                            />
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
    </Page>
</mvc:View>
