<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <!-- ═══ Debit notes panel : shown in place of Line items after the
         "Debit notes" module row is pressed. Calls DebitAmt1Set for the
         current Company Code/Supplier/date range, same stat-tile + table
         layout as Advance balance/Transactions — no bar chart. DebitAmt1Set
         doesn't return a per-row posting date, so the table skips a Date
         column. ═══ -->
    <VBox visible="{recon>/mdShowDebitNotes}">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <VBox class="mdStatTile mdStatTileNeutral">
                <Text
                    text="{recon>/mdLifnr}"
                    class="panelSubTitle mdNoMargin"
                />
                <Text
                    text="{recon>/mdSupplierName}"
                    class="panelSubTitle"
                />
            </VBox>
            <VBox class="mdStatTile mdStatTileBlue">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Debit amount"
                        class="mdStatLabel"
                    />
                    <core:Icon
                        src="sap-icon://document-text"
                        class="mdStatIcon mdStatIconBlue"
                    />
                </HBox>
                <Text
                    text="{ path: 'recon>/debitNotesTotal', formatter: '.formatBalanceValue' }"
                    class="mdStatValue"
                />
            </VBox>
            <VBox class="mdStatTile mdStatTileGreen">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Debit items"
                        class="mdStatLabel"
                    />
                    <core:Icon
                        src="sap-icon://list"
                        class="mdStatIcon mdStatIconGreen"
                    />
                </HBox>
                <Text
                    text="{= ${recon>/debitNotesItems}.length }"
                    class="mdStatValue"
                />
            </VBox>
        </FlexBox>

        <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
        >
            <Text
                text="{= 'Debit notes (' + ${recon>/debitNotesItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
        </HBox>

        <BusyIndicator
            visible="{recon>/debitNotesBusy}"
            size="1.5rem"
            class="sapUiSmallMarginTop"
        />

        <VBox class="mdTableScrollWrap">
            <Table
                id="debitNotesTable"
                items="{recon>/debitNotesItems}"
                noDataText="No debit notes found."
                sticky="ColumnHeaders"
                class="mdLineItemsTable"
            >
                <columns>
                    <Column>
                        <Label
                            text="Document"
                            design="Bold"
                        />
                    </Column>
                    <Column>
                        <Label
                            text="Type"
                            design="Bold"
                        />
                    </Column>
                    <Column hAlign="End">
                        <Label
                            text="Amount"
                            design="Bold"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text
                                text="{recon>Belnr}"
                            />
                            <Text
                                text="{recon>Blart}"
                            />
                            <ObjectNumber
                                number="{ path: 'recon>NetAmt', formatter: '.formatAmount' }"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
        <HBox
            class="mdLineItemsTotalRow"
            justifyContent="End"
        >
            <Label
                text="Total"
                design="Bold"
                class="sapUiTinyMarginEnd"
            />
            <ObjectNumber
                number="{ path: 'recon>/debitNotesTotal', formatter: '.formatAmount' }"
                state="{ path: 'recon>/debitNotesTotal', formatter: '.formatValueState' }"
            />
        </HBox>
    </VBox>
</core:FragmentDefinition>
