<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <!-- ═══ Advance balance panel : shown in place of Line items after the
         "Advance balance" module row is pressed. Calls VendBalAdvSet for
         the current Company Code/Supplier/key date, same stat-tile +
         table layout as Transactions — no bar chart. ═══ -->
    <VBox visible="{recon>/mdShowAdvance}">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <VBox class="mdStatTile mdStatTileNeutral">
                <Text
                    text="{recon>/mdLifnr}"
                    class="panelSubTitle mdNoMargin"
                />
                <Text
                    text="{recon>/mdSupplierName}"
                    class="panelSubTitle"
                />
            </VBox>
            <VBox class="mdStatTile mdStatTileBlue">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Advance amount"
                        class="mdStatLabel"
                    />
                    <core:Icon
                        src="sap-icon://trend-up"
                        class="mdStatIcon mdStatIconBlue"
                    />
                </HBox>
                <Text
                    text="{ path: 'recon>/advanceTotal', formatter: '.formatBalanceValue' }"
                    class="mdStatValue"
                />
            </VBox>
            <VBox class="mdStatTile mdStatTileGreen">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Advance items"
                        class="mdStatLabel"
                    />
                    <core:Icon
                        src="sap-icon://list"
                        class="mdStatIcon mdStatIconGreen"
                    />
                </HBox>
                <Text
                    text="{= ${recon>/advanceItems}.length }"
                    class="mdStatValue"
                />
            </VBox>
        </FlexBox>

        <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
        >
            <Text
                text="{= 'Advance balance (' + ${recon>/advanceItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
        </HBox>

        <BusyIndicator
            visible="{recon>/advanceBusy}"
            size="1.5rem"
            class="sapUiSmallMarginTop"
        />

        <VBox class="mdTableScrollWrap">
            <Table
                id="advanceTable"
                items="{recon>/advanceItems}"
                noDataText="No advance balance items found."
                sticky="ColumnHeaders"
                class="mdLineItemsTable"
            >
                <columns>
                    <Column>
                        <Label
                            text="Document"
                            design="Bold"
                        />
                    </Column>
                    <Column>
                        <Label
                            text="Date"
                            design="Bold"
                        />
                    </Column>
                    <Column>
                        <Label
                            text="Type"
                            design="Bold"
                        />
                    </Column>
                    <Column hAlign="End">
                        <Label
                            text="Amount"
                            design="Bold"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text
                                text="{recon>Belnr}"
                            />
                            <Text
                                text="{ path: 'recon>Budat', formatter: '.formatOpenItemDate' }"
                            />
                            <Text
                                text="{recon>Blart}"
                            />
                            <ObjectNumber
                                number="{ path: 'recon>NetAmt', formatter: '.formatAmount' }"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
        <HBox
            class="mdLineItemsTotalRow"
            justifyContent="End"
        >
            <Label
                text="Total"
                design="Bold"
                class="sapUiTinyMarginEnd"
            />
            <ObjectNumber
                number="{ path: 'recon>/advanceTotal', formatter: '.formatAmount' }"
                state="{ path: 'recon>/advanceTotal', formatter: '.formatValueState' }"
            />
        </HBox>
    </VBox>
</core:FragmentDefinition>
