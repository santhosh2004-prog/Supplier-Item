<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <FlexBox
        visible="{= !${recon>/mdShowGenericModule} &amp;&amp; !${recon>/mdShowTransactions} &amp;&amp; !${recon>/mdShowPayments} &amp;&amp; !${recon>/mdShowAdvance} &amp;&amp; !${recon>/mdShowDebitNotes} }"
        class="mdStatTilesRow"
        wrap="Wrap"
    >
        <VBox class="mdStatTile mdStatTileNeutral">
            <Text
                text="{recon>/mdLifnr}"
                class="panelSubTitle mdNoMargin"
            />
            <Text
                text="{recon>/mdSupplierName}"
                class="panelSubTitle"
            />
        </VBox>
        <VBox class="mdStatTile mdStatTileBlue">
            <HBox
                justifyContent="SpaceBetween"
                alignItems="Center"
            >
                <Text
                    text="Balance value"
                    class="mdStatLabel"
                />
                <core:Icon
                    src="sap-icon://wallet"
                    class="mdStatIcon mdStatIconBlue"
                />
            </HBox>
            <Text
                text="{ path: 'recon>/openingBalanceValue', formatter: '.formatBalanceValue' }"
                class="mdStatValue"
            />
        </VBox>
        <VBox class="mdStatTile mdStatTileGreen">
            <HBox
                justifyContent="SpaceBetween"
                alignItems="Center"
            >
                <Text
                    text="Open items"
                    class="mdStatLabel"
                />
                <core:Icon
                    src="sap-icon://list"
                    class="mdStatIcon mdStatIconGreen"
                />
            </HBox>
            <Text
                text="{= ${recon>/openItems}.length }"
                class="mdStatValue"
            />
        </VBox>
    </FlexBox>

    <!-- ═══ Chart column (fixed width, only as tall as its 6 bars) beside the
         Line items table (fills the rest of the row) — instead of stacking
         them full-width, which left a big blank rectangle next to the chart. ═══ -->
    <HBox
        visible="{= !${recon>/mdShowGenericModule} &amp;&amp; !${recon>/mdShowTransactions} &amp;&amp; !${recon>/mdShowPayments} &amp;&amp; !${recon>/mdShowAdvance} &amp;&amp; !${recon>/mdShowDebitNotes} }"
        class="mdChartAndLineItemsRow"
        alignItems="Start"
    >
        <VBox class="mdChartColumn">
            <Text
                text="{= 'Last Six months Balance — ' + ${recon>/mdBarChartRangeLabel} }"
                class="panelSubTitle"
            />
            <core:HTML
                id="mdBarChartHtml"
                content="&lt;div id='mdBarChartContainer' class='mdBarChartRow'&gt;&lt;/div&gt;"
                afterRendering=".onMdBarChartHtmlRendered"
            />
        </VBox>

        <VBox class="mdLineItemsColumn">
            <Text
                text="{= (${recon>/mdSelectedMonthLabel} ? 'Line items — ' + ${recon>/mdSelectedMonthLabel} + ' (' : 'Line items (') + ${recon>/openItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle"
            />

            <BusyIndicator
                visible="{recon>/openItemsBusy}"
                size="1.5rem"
                class="sapUiSmallMarginTop"
            />

            <VBox class="mdTableScrollWrap">
                <Table
                    id="masterDetailTable"
                    items="{recon>/openItems}"
                    noDataText="No line items found."
                    sticky="ColumnHeaders"
                    class="mdLineItemsTable"
                >
                    <columns>
                        <Column>
                            <Label
                                text="Document"
                                design="Bold"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Date"
                                design="Bold"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Type"
                                design="Bold"
                            />
                        </Column>
                        <Column hAlign="End">
                            <Label
                                text="Amount"
                                design="Bold"
                            />
                        </Column>
                        <Column hAlign="End">
                            <Label
                                text="Status"
                                design="Bold"
                            />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Inactive">
                            <cells>
                                <Text
                                    text="{recon>Belnr}"
                                />
                                <Text
                                    text="{ path: 'recon>Budat', formatter: '.formatOpenItemDate' }"
                                />
                                <Text
                                    text="{recon>Blart}"
                                />
                                <ObjectNumber
                                    number="{ path: 'recon>NetAmt', formatter: '.formatAmount' }"
                                />
                                <ObjectStatus
                                    text="{ path: 'recon>Augbl', formatter: '.formatOpenItemStatus' }"
                                    state="{ path: 'recon>Augbl', formatter: '.formatOpenItemStatusState' }"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
            <HBox
                class="mdLineItemsTotalRow"
                justifyContent="End"
            >
                <Label
                    text="Total"
                    design="Bold"
                    class="sapUiTinyMarginEnd"
                />
                <ObjectNumber
                    number="{ path: 'recon>/openItemsTotal', formatter: '.formatAmount' }"
                    state="{ path: 'recon>/openItemsTotal', formatter: '.formatValueState' }"
                />
            </HBox>
        </VBox>
    </HBox>

</core:FragmentDefinition>
