<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="openItemsDetailDialog"
        title="{recon>/filteredOpenItemsTitle}"
        contentWidth="100%"
        contentHeight="100%"
        stretch="true"
        verticalScrolling="true"
        horizontalScrolling="true"
    >
        <content>
            <Table
                id="openItemsDetailTable"
                items="{recon>/filteredOpenItems}"
                noDataText="No documents found."
                sticky="ColumnHeaders"
                fixedLayout="false"
                popinLayout="GridSmall"
            >
                <columns>
                    <Column width="8rem">
                        <Label
                            text="Doc No"
                            design="Bold"
                        />
                    </Column>
                    <Column width="5rem">
                        <Label
                            text="Doc Type"
                            design="Bold"
                        />
                    </Column>
                    <Column width="7rem">
                        <Label
                            text="Posting Date"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="7rem"
                        minScreenWidth="Large"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Label
                            text="Doc Date"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="7rem"
                        minScreenWidth="Large"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Label
                            text="Vendor"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="4rem"
                        minScreenWidth="XLarge"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Label
                            text="Sp.GL"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="8rem"
                        minScreenWidth="XLarge"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Label
                            text="Clearing Doc"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="8rem"
                        minScreenWidth="XLarge"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Label
                            text="PO Number"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="9rem"
                        hAlign="End"
                    >
                        <Label
                            text="Invoice Amt"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="9rem"
                        hAlign="End"
                    >
                        <Label
                            text="Advance Amt"
                            design="Bold"
                        />
                    </Column>
                    <Column
                        width="9rem"
                        hAlign="End"
                    >
                        <Label
                            text="Net Amt"
                            design="Bold"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{recon>Belnr}" />
                            <Text text="{recon>Blart}" />
                            <Text
                                text="{
                                    path: 'recon>Budat',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { pattern: 'dd.MM.yyyy' }
                                }"
                            />
                            <Text
                                text="{
                                    path: 'recon>Bldat',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { pattern: 'dd.MM.yyyy' }
                                }"
                            />
                            <Text text="{recon>Lifnr}" />
                            <Text text="{recon>Umskz}" />
                            <Text text="{recon>Augbl}" />
                            <Text text="{recon>Ebeln}" />
                            <ObjectNumber
                                number="{ path: 'recon>InvAmt', formatter: '.formatAmount' }"
                            />
                            <ObjectNumber
                                number="{ path: 'recon>AdvAmt', formatter: '.formatAmount' }"
                            />
                            <ObjectNumber
                                number="{ path: 'recon>NetAmt', formatter: '.formatAmount' }"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button
                text="Close"
                press=".onCloseOpenItemsDetail"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
