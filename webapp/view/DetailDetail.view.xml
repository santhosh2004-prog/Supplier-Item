<mvc:View
    controllerName="supplieropenitems.controller.DetailDetail"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
>
    <uxap:ObjectPageLayout
        id="ObjectPageLayout"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="false"
        preserveHeaderStateOnScroll="false"
        headerContentPinnable="true"
        isChildPage="true"
        upperCaseAnchorBar="false"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:heading>
                    <Title
                        text="{recon>LIFNR} — {recon>NAME1}"
                        level="H3"
                    />
                </uxap:heading>

                <uxap:navigationActions>
                    <OverflowToolbarButton
                        type="Transparent"
                        icon="sap-icon://full-screen"
                        press=".handleFullScreen"
                        tooltip="Enter Full Screen"
                        visible="{= !${appView>/actionButtonsInfo/endColumn/fullScreen}}"
                    />
                    <OverflowToolbarButton
                        type="Transparent"
                        icon="sap-icon://exit-full-screen"
                        press=".handleExitFullScreen"
                        tooltip="Exit Full Screen"
                        visible="{= ${appView>/actionButtonsInfo/endColumn/fullScreen}}"
                    />
                    <OverflowToolbarButton
                        type="Transparent"
                        icon="sap-icon://decline"
                        press=".handleClose"
                        tooltip="Close"
                    />
                </uxap:navigationActions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent />

        <uxap:sections>
            <uxap:ObjectPageSection title="Open Items">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <VBox width="100%">
                                <BusyIndicator
                                    visible="{recon>itemsBusy}"
                                    size="2rem"
                                    class="sapUiMediumMarginTop"
                                />

                                <Table
                                    id="openItemsTable"
                                    items="{recon>openItems}"
                                    noDataText="No open items found."
                                    sticky="ColumnHeaders"
                                    visible="{recon>itemsLoaded}"
                                    growing="true"
                                    growingThreshold="20"
                                    showSeparators="All"
                                    fixedLayout="false"
                                    popinLayout="GridSmall"
                                >
                                    <columns>
                                        <Column width="9rem">
                                            <Label
                                                text="Doc No"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column width="7rem">
                                            <Label
                                                text="Doc Type"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column
                                            width="9rem"
                                            minScreenWidth="Small"
                                            demandPopin="true"
                                            popinDisplay="Inline"
                                        >
                                            <Label
                                                text="Posting Date"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column
                                            width="9rem"
                                            minScreenWidth="Small"
                                            demandPopin="true"
                                            popinDisplay="Inline"
                                        >
                                            <Label
                                                text="Doc Date"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column
                                            width="6rem"
                                            minScreenWidth="Medium"
                                            demandPopin="true"
                                            popinDisplay="Inline"
                                        >
                                            <Label
                                                text="Spl G/L"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column
                                            width="9rem"
                                            minScreenWidth="Medium"
                                            demandPopin="true"
                                            popinDisplay="Inline"
                                        >
                                            <Label
                                                text="Clrng Doc"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column
                                            width="10rem"
                                            hAlign="End"
                                        >
                                            <Label
                                                text="Invoice Amt"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column
                                            width="10rem"
                                            hAlign="End"
                                            minScreenWidth="Medium"
                                            demandPopin="true"
                                            popinDisplay="Inline"
                                        >
                                            <Label
                                                text="Advance Amt"
                                                design="Bold"
                                            />
                                        </Column>
                                        <Column
                                            width="10rem"
                                            hAlign="End"
                                        >
                                            <Label
                                                text="Net Amt"
                                                design="Bold"
                                            />
                                        </Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{recon>Belnr}" />
                                                <Text text="{recon>Blart}" />
                                                <Text text="{recon>Budat}" />
                                                <Text text="{recon>Bldat}" />
                                                <Text text="{recon>Umskz}" />
                                                <Text text="{recon>Augbl}" />
                                                <ObjectNumber
                                                    number="{recon>InvAmt}"
                                                    textAlign="End"
                                                />
                                                <ObjectNumber
                                                    number="{recon>AdvAmt}"
                                                    textAlign="End"
                                                />
                                                <ObjectNumber
                                                    number="{recon>NetAmt}"
                                                    textAlign="End"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
