<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
   
    <VBox visible="{recon>/mdShowPendingPO}" class="mdPanelAnimate">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <HBox
                justifyContent="Start"
                class="mdSidebarReopenRow"
                visible="{= !${recon>/mdLeftPanelOpen} }"
            >
                <Button
                    id="mdLeftPanelMenuButtonPendingPO"
                    icon="sap-icon://navigation-right-arrow"
                    type="Transparent"
                    tooltip="Open"
                    class="mdSidebarGroupTitle"
                    press=".onMdLeftPanelMenuPress"
                />
            </HBox>
            <!-- ═══ Identity + Total pending PO amount + Total pending PO
                 items, all kept in this one tile — same layout as the
                 Total PO value panel's identity tile (see
                 TotalPOPanel.fragment.xml): identity full-width across the
                 top, a horizontal divider, then amount / items side by
                 side below, split by a vertical divider. ═══ -->
            <VBox
                visible="{= ${recon>/pendingPOBusy} || ${recon>/pendingPOItems}.length > 0 }"
                class="mdStatTile1 mdStatTileNeutral mdPaymentsIdentityTile"
            >
               

             
                <HBox class="mdPaymentsTileCols">
                    <VBox class="mdPaymentsTileCol">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                        >
                            <Text
                                text="Total Pending PO Amount"
                                class="panelSubTitle mdNoMargin textLeft"
                            />
                            <core:Icon
                                src="sap-icon://trend-up"
                                class="mdStatIcon mdStatIconBlue"
                            />
                        </HBox>
                        <Text
                            text="₹ { path: 'recon>/pendingPOTotal', formatter: '.formatBalanceValue' }"
                            class="mdStatValue"
                        />
                    </VBox>
                    <VBox class="mdPaymentsTileCol mdPaymentsTileColRight">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                        >
                            <Text
                                text="Total Pending PO Items"
                                class="panelSubTitle mdNoMargin textLeft "
                            />
                            <core:Icon
                                src="sap-icon://list"
                                class="mdStatIcon mdStatIconGreen"
                            />
                        </HBox>
                        <Text
                            text="{= ${recon>/pendingPOItems}.length }"
                            class="mdStatValue"
                        />
                    </VBox>
                </HBox>
                <HBox class="mdPaymentsTileDivider" />
                   <HBox alignItems="Center" class="mdStatTileContent">
                    <Text
                        text="Total Quantity :"
                        class="panelSubTitle mdNoMargin textLeft"
                    />
                    <Text
                        text="{ path: 'recon>/pendingPOQty', formatter: '.formatAmount' }"
                        class="panelSubValue mdNoMargin openingBalanceValue "
                    />
                </HBox>

                

            </VBox>
            <!-- ═══ "PO / Contract" horizontal bar chart — same idea as the
                 Total PO value panel's chart (see TotalPOPanel.fragment.xml
                 + _renderTotalPOTypeBarChart), split by Bstyp: "F" is a PO,
                 "K" is a Contract. ═══ -->
            <VBox
                visible="{= ${recon>/pendingPOBusy} || ${recon>/pendingPOItems}.length > 0 }"
                class="mdStatTile1 mdStatTileNeutral"
            >
                <core:HTML
                    id="mdPendingPOBarChartHtml"
                    content="&lt;div id='mdPendingPOBarChartContainer' class='mdHBarChartWrap'&gt;&lt;/div&gt;"
                    afterRendering=".onMdPendingPOBarChartHtmlRendered"
                />
            </VBox>
            
        </FlexBox>

        <IllustratedMessage
            visible="{= !${recon>/pendingPOBusy} &amp;&amp; ${recon>/pendingPOItems}.length === 0 }"
            illustrationType="sapIllus-NoData"
            illustrationSize="Spot"
            title="No Pending PO Data"
            description="{= 'No pending PO items found for ' + (${recon>/mdSupplierName} || ${recon>/mdLifnr}) + '.' }"
            class="mdNoDataIllustration"
        />

        <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
            visible="{= ${recon>/pendingPOBusy} || ${recon>/pendingPOItems}.length > 0 }"
        >
            <Text
                text="{= 'Pending PO (' + ${recon>/pendingPOItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
            <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="pendingPOTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="pendingPOTable" />
                    </customData>
                </Button>
            </HBox>
        </HBox>

        <table:Table
            id="pendingPOTable"
            width="100%"
            rowHeight="24"
            columnHeaderHeight="26"
            rows="{recon>/pendingPOItems}"
            busy="{recon>/pendingPOBusy}"
            busyIndicatorDelay="0"
            visible="{= ${recon>/pendingPOBusy} || ${recon>/pendingPOItems}.length > 0 }"
            selectionMode="None"
            enableColumnReordering="false"
            visibleRowCountMode="Auto"
            minAutoRowCount="10"
            noData="No pending PO items found."
            class="mdLineItemsTable mdGridTable"
        >
            <table:columns>
                <table:Column width="15%" sortProperty="Ebeln" filterProperty="Ebeln">
                    <table:label>
                        <Label text="PO Number" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Ebeln}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col1" />
                    </table:customData>
                </table:Column>
                <table:Column width="12%" sortProperty="Bedat" filterProperty="Bedat">
                    <table:label>
                        <Label text="Date" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{ path: 'recon>Bedat', formatter: '.formatOpenItemDate' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col7" />
                    </table:customData>
                </table:Column>
                <table:Column width="23%" sortProperty="Txz01" filterProperty="Txz01">
                    <table:label>
                        <Label text="Material" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Txz01}" wrapping="false" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col8" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="13%"
                    hAlign="End"
                    sortProperty="PendQty"
                    filterProperty="PendQty"
                >
                    <table:label>
                        <Label text="Quantity" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{= ${recon>PendQty} + ' ' + ${recon>Meins} }" textAlign="End" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col23" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="15%"
                    hAlign="End"
                    sortProperty="Netpr"
                    filterProperty="Netpr"
                >
                    <table:label>
                        <Label text="Unit Price" design="Bold" />
                    </table:label>
                    <table:template>
                        <ObjectNumber number="{ path: 'recon>Netpr', formatter: '.formatAmount' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col9" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="22%"
                    hAlign="End"
                    sortProperty="PendVal"
                    filterProperty="PendVal"
                >
                    <table:label>
                        <Label text="Pending Amount" design="Bold" />
                    </table:label>
                    <table:template>
                        <ObjectNumber number="{ path: 'recon>PendVal', formatter: '.formatAmount' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col24" />
                    </table:customData>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
