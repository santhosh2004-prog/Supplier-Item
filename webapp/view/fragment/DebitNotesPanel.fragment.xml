<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <!-- ═══ Debit notes panel : shown in place of Line items after the
         "Debit notes" module row is pressed. Calls DebitAmt1Set for the
         current Company Code/Supplier/date range, same stat-tile + table
         layout as Advance balance/Transactions — no bar chart. DebitAmt1Set
         doesn't return a per-row posting date, so the table skips a Date
         column. ═══ -->
    <VBox visible="{recon>/mdShowDebitNotes}" class="mdPanelAnimate">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <HBox
                justifyContent="Start"
                class="mdSidebarReopenRow"
                visible="{= !${recon>/mdLeftPanelOpen} }"
            >
                <Button
                    id="mdLeftPanelMenuButtonDebitNotes"
                    icon="sap-icon://navigation-right-arrow"
                    type="Transparent"
                    tooltip="Open"
                    class="mdSidebarGroupTitle"
                    press=".onMdLeftPanelMenuPress"
                />
            </HBox>
            <VBox
                visible="{= ${recon>/debitNotesBusy} || ${recon>/debitNotesItems}.length > 0 }"
                class="mdStatTile mdStatTileBlue"
            >
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox alignItems="Center" class="mdStatTileContent">
                        <Text
                            text="Debit Amount :"
                            class="panelSubTitle mdNoMargin textLeft"
                        />
                        <Text
                            text="{ path: 'recon>/debitNotesTotal', formatter: '.formatBalanceValue' }"
                            class="panelSubValue mdNoMargin debitAmountValue"
                        />
                    </HBox>
                </HBox>
            </VBox>
            <VBox
                visible="{= ${recon>/debitNotesBusy} || ${recon>/debitNotesItems}.length > 0 }"
                class="mdStatTile mdStatTileGreen"
            >
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox alignItems="Center" class="mdStatTileContent">
                        <Text
                            text="Debit Items :"
                            class="panelSubTitle mdNoMargin textLeft"
                        />
                        <Text
                            text="{= ${recon>/debitNotesItems}.length }"
                            class="panelSubValue mdNoMargin debitItemsValue"
                        />
                    </HBox>
                </HBox>
            </VBox>
             <!-- <HBox class="mdExportBtns">
                <Button
                    icon="sap-icon://refresh"
                    type="Transparent"
                    tooltip="Refresh"
                    press=".onRefreshMasterDetail"
                />
                <Button
                    icon="sap-icon://nav-back"
                    type="Success"
                    tooltip="Back to Chart"
                    press=".onBackToChart"
                />
            </HBox> -->
             <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="debitNotesTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="debitNotesTable" />
                    </customData>
                </Button>
            </HBox>
        </FlexBox>

        <IllustratedMessage
            visible="{= !${recon>/debitNotesBusy} &amp;&amp; ${recon>/debitNotesItems}.length === 0 }"
            illustrationType="sapIllus-NoData"
            illustrationSize="Spot"
            title="No Debit Notes Data"
            description="{= 'No debit notes found for ' + (${recon>/mdSupplierName} || ${recon>/mdLifnr}) + '.' }"
            class="mdNoDataIllustration"
        />

        <!-- <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
            visible="{= ${recon>/debitNotesBusy} || ${recon>/debitNotesItems}.length > 0 }"
        >
            <Text
                text="{= 'Debit Notes (' + ${recon>/debitNotesItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
            <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="debitNotesTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="debitNotesTable" />
                    </customData>
                </Button>
            </HBox>
        </HBox> -->

        <table:Table
            id="debitNotesTable"
            width="100%"
            rowHeight="24"
            columnHeaderHeight="26"
            rows="{recon>/debitNotesItems}"
            busy="{recon>/debitNotesBusy}"
            busyIndicatorDelay="0"
            visible="{= ${recon>/debitNotesBusy} || ${recon>/debitNotesItems}.length > 0 }"
            selectionMode="None"
            enableColumnReordering="false"
            visibleRowCountMode="Auto"
            minAutoRowCount="13"
            noData="No debit notes found."
            class="mdLineItemsTable mdGridTable"
        >
            <table:columns>
                <!-- ═══ customData key="colId" — same shared colId scheme as
                     masterDetailTable; oiCol2 (Date) and oiCol5 (Status) are
                     included here for schema parity with the other tables
                     even though DebitAmt1Set returns neither a posting date
                     nor a clearing document (so Date renders blank and
                     Status always shows "Open") — dropped or reordered like
                     any other column via Column Settings. ═══ -->
                <table:Column width="20%" sortProperty="Belnr" filterProperty="Belnr">
                    <table:label>
                        <Label text="Document" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Belnr}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol1" />
                    </table:customData>
                </table:Column>
                <table:Column width="15%" sortProperty="Budat" filterProperty="Budat">
                    <table:label>
                        <Label text="Date" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{ path: 'recon>Budat', formatter: '.formatOpenItemDate' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol2" />
                    </table:customData>
                </table:Column>
                <table:Column width="30%" sortProperty="Blart" filterProperty="Blart">
                    <table:label>
                        <Label text="Type" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Blart}" wrapping="false" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol3" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="20%"
                    hAlign="End"
                    sortProperty="NetAmt"
                    filterProperty="NetAmt"
                >
                    <table:label>
                        <Label text="Amount" design="Bold" />
                    </table:label>
                    <table:template>
                        <ObjectNumber number="{ path: 'recon>NetAmt', formatter: '.formatAmount' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol4" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="15%"
                    hAlign="End"
                    sortProperty="Augbl"
                    filterProperty="Augbl"
                >
                    <table:label>
                        <Label text="Status" design="Bold" />
                    </table:label>
                    <table:template>
                        <ObjectStatus
                            text="{ path: 'recon>Augbl', formatter: '.formatOpenItemStatus' }"
                            state="{ path: 'recon>Augbl', formatter: '.formatOpenItemStatusState' }"
                        />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol5" />
                    </table:customData>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
