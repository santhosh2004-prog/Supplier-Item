<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <!-- ═══ Material receipts panel : shown in place of Line items after
         the "Material receipts" module row is pressed. Calls MatReceiptSet
         for the current Company Code/Supplier over the searched From/To
         Date range (Fromdate/Todate — MatReceiptSet's own filter names,
         same as LotAcceptSet/LotAUDSet but with a Bukrs filter too, like
         TotalPOSet), same stat-tile + table layout as Debit notes/Advance
         balance — no bar chart (goods receipts have no value field to
         chart or sum, only a quantity). ═══ -->
    <VBox visible="{recon>/mdShowMatReceipts}" class="mdPanelAnimate">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <HBox
                justifyContent="Start"
                class="mdSidebarReopenRow"
                visible="{= !${recon>/mdLeftPanelOpen} }"
            >
                <Button
                    id="mdLeftPanelMenuButtonMatReceipts"
                    icon="sap-icon://navigation-right-arrow"
                    type="Transparent"
                    tooltip="Open"
                    class="mdSidebarGroupTitle"
                    press=".onMdLeftPanelMenuPress"
                />
            </HBox>
            <!-- ═══ Identity tile — same layout as the Total PO value
                 panel's identity tile (see TotalPOPanel.fragment.xml):
                 identity full-width across the top, a horizontal divider,
                 then Receipt Items / Total Amount / Average Price below. ═══ -->
            <VBox
                visible="{= ${recon>/matReceiptsBusy} || ${recon>/matReceiptsItems}.length > 0 }"
                class="mdStatTile1 mdStatTileNeutral mdPaymentsIdentityTile"
            >
                <HBox class="mdPaymentsTileCols">
                    <VBox class="mdPaymentsTileCol">
                        <HBox alignItems="Center" class="mdStatTileContent">
                            <Text
                                text="Total Receipt Qty :"
                                class="panelSubTitle mdNoMargin textLeft"
                            />
                            <Text
                                text="{ path: 'recon>/matReceiptsTotal', formatter: '.formatBalanceValue' }"
                                class="panelSubValue mdNoMargin openingBalanceValue "
                            />
                        </HBox>
                    </VBox>
                    <VBox class="mdPaymentsTileCol mdPaymentsTileColRight">
                        <HBox alignItems="Center" class="mdStatTileContent">
                            <Text
                                text="Receipt Items :"
                                class="panelSubTitle mdNoMargin textLeft "
                            />
                            <Text
                                text="{= ${recon>/matReceiptsItems}.length }"
                                class="panelSubValue mdNoMargin openingBalanceValue"
                            />
                        </HBox>
                    </VBox>
                </HBox>
                <HBox class="mdPaymentsTileDivider" />

                <HBox class="mdPaymentsTileCols">
                    <VBox class="mdPaymentsTileCol">
                        <HBox alignItems="Center" class="mdStatTileContent">
                            <Text
                                text="Total Amount :"
                                class="panelSubTitle mdNoMargin textLeft"
                            />
                            <Text
                                text="₹ { path: 'recon>/matReceiptsValueTotal', formatter: '.formatAmount' }"
                                class="panelSubValue mdNoMargin openingBalanceValue "
                            />
                        </HBox>
                    </VBox>
                    <VBox class="mdPaymentsTileCol mdPaymentsTileColRight">
                        <HBox alignItems="Center" class="mdStatTileContent">
                            <Text
                                text="Average Price :"
                                class="panelSubTitle mdNoMargin textLeft"
                            />
                            <Text
                                text="₹ {= ${recon>/matReceiptsTotal} ? (${recon>/matReceiptsValueTotal} / ${recon>/matReceiptsTotal}).toFixed(2) : '0.00' }"
                                class="panelSubValue mdNoMargin openingBalanceValue"
                            />
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>
            <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://filter"
                    text="{= ${recon>/matReceiptsSelectedMaterials}.length > 0 ? 'Material (' + ${recon>/matReceiptsSelectedMaterials}.length + ')' : 'Material' }"
                    type="Transparent"
                    tooltip="Filter by Material"
                    press=".onMatReceiptsMaterialFilterPress"
                />
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="matReceiptsTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="matReceiptsTable" />
                    </customData>
                </Button>
            </HBox>
        </FlexBox>

        <IllustratedMessage
            visible="{= !${recon>/matReceiptsBusy} &amp;&amp; ${recon>/matReceiptsItems}.length === 0 }"
            illustrationType="sapIllus-NoData"
            illustrationSize="Spot"
            title="No Material Receipts Data"
            description="{= 'No material receipts found for ' + (${recon>/mdSupplierName} || ${recon>/mdLifnr}) + '.' }"
            class="mdNoDataIllustration"
        />

        <!-- <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
            visible="{= ${recon>/matReceiptsBusy} || ${recon>/matReceiptsItems}.length > 0 }"
        >
            <Text
                text="{= 'Material Receipts (' + ${recon>/matReceiptsItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
            <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="matReceiptsTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="matReceiptsTable" />
                    </customData>
                </Button>
            </HBox>
        </HBox> -->

        <table:Table
            id="matReceiptsTable"
            width="100%"
            rowHeight="24"
            columnHeaderHeight="26"
            rows="{recon>/matReceiptsItems}"
            busy="{recon>/matReceiptsBusy}"
            busyIndicatorDelay="0"
            visible="{= ${recon>/matReceiptsBusy} || ${recon>/matReceiptsItems}.length > 0 }"
            selectionMode="None"
            enableColumnReordering="false"
            visibleRowCountMode="Auto"
            minAutoRowCount="14"
            noData="No material receipts found."
            class="mdLineItemsTable mdGridTable"
        >
            <table:columns>
                <table:Column width="16%" sortProperty="Mblnr" filterProperty="Mblnr">
                    <table:label>
                        <Label text="Material Doc." design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Mblnr}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col14" />
                    </table:customData>
                </table:Column>
                <table:Column width="14%" sortProperty="Budat_mkpf" filterProperty="Budat_mkpf">
                    <table:label>
                        <Label text="Date" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{ path: 'recon>Budat_mkpf', formatter: '.formatOpenItemDate' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col15" />
                    </table:customData>
                </table:Column>
                <table:Column width="12%" sortProperty="Werks" filterProperty="Werks">
                    <table:label>
                        <Label text="Plant" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Werks}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col16" />
                    </table:customData>
                </table:Column>
                <table:Column width="16%" sortProperty="Ebeln" filterProperty="Ebeln">
                    <table:label>
                        <Label text="PO Number" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Ebeln}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col1" />
                    </table:customData>
                </table:Column>
                <table:Column width="14%" sortProperty="Matnr" filterProperty="Matnr">
                    <table:label>
                        <Label text="Material" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Matnr}" wrapping="false" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col5" />
                    </table:customData>
                </table:Column>
                <table:Column width="10%" sortProperty="Bwart" filterProperty="Bwart">
                    <table:label>
                        <Label text="Mvt Type" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Bwart}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col17" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="18%"
                    hAlign="End"
                    sortProperty="Menge"
                    filterProperty="Menge"
                >
                    <table:label>
                        <Label text="Quantity" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{= (Math.floor(Number(${recon>Menge}) * 100) / 100).toFixed(2) + ' ' + ${recon>Meins} }" textAlign="End" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col6" />
                    </table:customData>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
