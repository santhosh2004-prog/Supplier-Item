<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <!-- ═══ Total PO value panel : shown in place of Line items after the
         "Total PO value" module row is pressed. Calls TotalPOSet for the
         current Company Code/Supplier over the searched From/To Date range
         (BudatFrom/BudatTo, same two-discrete-filter pattern as Debit
         notes), same stat-tile + table layout as Advance balance/Debit
         notes — no bar chart. ═══ -->
    <VBox visible="{recon>/mdShowTotalPO}" class="mdPanelAnimate">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <HBox
                justifyContent="Start"
                class="mdSidebarReopenRow"
                visible="{= !${recon>/mdLeftPanelOpen} }"
            >
                <Button
                    id="mdLeftPanelMenuButtonTotalPO"
                    icon="sap-icon://navigation-right-arrow"
                    type="Transparent"
                    tooltip="Open"
                    class="mdSidebarGroupTitle"
                    press=".onMdLeftPanelMenuPress"
                />
            </HBox>
            <!-- ═══ Identity +  + Total PO items, all kept in
                 this one tile — same layout as the Payments panel's
                 identity tile (see PaymentsPanel.fragment.xml): identity
                 full-width across the top, a horizontal divider, then
                  / Total PO items side by side below,
                 split by a vertical divider. ═══ -->
            <VBox
                visible="{= ${recon>/totalPOBusy} || ${recon>/totalPOItems}.length > 0 }"
                class="mdStatTile1 mdStatTileNeutral mdPaymentsIdentityTile"
            >
                <HBox class="mdPaymentsTileCols">
                    <VBox class="mdPaymentsTileCol">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                        >
                            <Text
                                text="Total PO Amount"
                                class="panelSubTitle mdNoMargin textLeft"
                            />
                            <core:Icon
                                src="sap-icon://trend-up"
                                class="mdStatIcon mdStatIconBlue"
                            />
                        </HBox>
                        <Text
                            text="₹ { path: 'recon>/totalPOTotal', formatter: '.formatBalanceValue' }"
                            class="mdStatValue"
                        />
                    </VBox>
                    <VBox class="mdPaymentsTileCol mdPaymentsTileColRight">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                        >
                            <Text
                                text="Total PO Items"
                                class="panelSubTitle mdNoMargin textLeft "
                            />
                            <core:Icon
                                src="sap-icon://list"
                                class="mdStatIcon mdStatIconGreen"
                            />
                        </HBox>
                        <Text
                            text="{= ${recon>/totalPOItems}.length }"
                            class="mdStatValue"
                        />
                    </VBox>
                </HBox>
                <HBox class="mdPaymentsTileDivider" />

                <HBox class="mdPaymentsTileCols">
                    <VBox class="mdPaymentsTileCol">
                        <HBox alignItems="Center" class="mdStatTileContent">
                            <Text
                                text="Total Quantity :"
                                class="panelSubTitle mdNoMargin textLeft"
                            />
                            <Text
                                text="{ path: 'recon>/totalPOQty', formatter: '.formatAmount' }"
                                class="panelSubValue mdNoMargin openingBalanceValue "
                            />
                        </HBox>
                    </VBox>
                    <VBox class="mdPaymentsTileCol mdPaymentsTileColRight">
                        <HBox alignItems="Center" class="mdStatTileContent">
                            <Text
                                text="PO Average Price :"
                                class="panelSubTitle mdNoMargin textLeft"
                            />
                            <Text
                                text="₹ {= (${recon>/totalPOTotal} / ${recon>/totalPOQty}).toFixed(2) }"
                                class="panelSubValue mdNoMargin openingBalanceValue"
                            />
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>
            <VBox
                visible="{= ${recon>/totalPOBusy} || ${recon>/totalPOItems}.length > 0 }"
                class="mdStatTile1 mdStatTileNeutral"
            >
                <core:HTML
                    id="mdTotalPOBarChartHtml"
                    content="&lt;div id='mdTotalPOBarChartContainer' class='mdHBarChartWrap'&gt;&lt;/div&gt;"
                    afterRendering=".onMdTotalPOBarChartHtmlRendered"
                />
            </VBox>
          
        </FlexBox>

        <IllustratedMessage
            visible="{= !${recon>/totalPOBusy} &amp;&amp; ${recon>/totalPOItems}.length === 0 }"
            illustrationType="sapIllus-NoData"
            illustrationSize="Spot"
            title="No Purchase Order Data"
            description="{= 'No purchase order items found for ' + (${recon>/mdSupplierName} || ${recon>/mdLifnr}) + '.' }"
            class="mdNoDataIllustration"
        />

        <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
            visible="{= ${recon>/totalPOBusy} || ${recon>/totalPOItems}.length > 0 }"
        >
            <Text
                text="{= 'Total PO Value (' + ${recon>/totalPOItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
            <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://filter"
                    text="{= ${recon>/totalPOSelectedMaterials}.length > 0 ? 'Material (' + ${recon>/totalPOSelectedMaterials}.length + ')' : 'Material' }"
                    type="Transparent"
                    tooltip="Filter by Material"
                    press=".onTotalPOMaterialFilterPress"
                />
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="totalPOTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="totalPOTable" />
                    </customData>
                </Button>
            </HBox>
        </HBox>

        <table:Table
            id="totalPOTable"
            width="100%"
            rowHeight="24"
            columnHeaderHeight="26"
            rows="{recon>/totalPOItems}"
            busy="{recon>/totalPOBusy}"
            busyIndicatorDelay="0"
            visible="{= ${recon>/totalPOBusy} || ${recon>/totalPOItems}.length > 0 }"
            selectionMode="None"
            enableColumnReordering="false"
            visibleRowCountMode="Auto"
            minAutoRowCount="11"
            noData="No purchase order items found."
            class="mdLineItemsTable mdGridTable"
        >
            <table:columns>
                <table:Column width="15%" sortProperty="Ebeln" filterProperty="Ebeln">
                    <table:label>
                        <Label text="PO Number" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Ebeln}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col1" />
                    </table:customData>
                </table:Column>
                <table:Column width="12%" sortProperty="Bedat" filterProperty="Bedat">
                    <table:label>
                        <Label text="Date" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{ path: 'recon>Bedat', formatter: '.formatOpenItemDate' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col7" />
                    </table:customData>
                </table:Column>
                <table:Column width="23%" sortProperty="Txz01" filterProperty="Txz01">
                    <table:label>
                        <Label text="Material" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Txz01}" wrapping="false" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col8" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="13%"
                    hAlign="End"
                    sortProperty="Menge"
                    filterProperty="Menge"
                >
                    <table:label>
                        <Label text="Quantity" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{= ${recon>Menge} + ' ' + ${recon>Meins} }" textAlign="End" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col6" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="13%"
                    hAlign="End"
                    sortProperty="Netpr"
                    filterProperty="Netpr"
                >
                    <table:label>
                        <Label text="Unit Price " design="Bold" />
                    </table:label>
                    <table:template>
    <Text
        text="{ path: 'recon>Netpr', formatter: '.formatAmount' }"
        textAlign="End"
    />
</table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col9" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="22%"
                    hAlign="End"
                    sortProperty="Netwr"
                    filterProperty="Netwr"
                >
                    <table:label>
                        <Label text="Net Value" design="Bold" />
                    </table:label>
                    <table:template>
                        <ObjectNumber number="{ path: 'recon>Netwr', formatter: '.formatAmount' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col21" />
                    </table:customData>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
