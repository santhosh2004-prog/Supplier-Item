<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <!-- ═══ Lots accepted panel : shown in place of Line items after the
         "Lots accepted" module row (QUALITY (QM) group) is pressed. Calls
         LotAcceptSet for the current Supplier over the searched From/To Date
         range (Fromdate/Todate — LotAcceptSet's own filter names, keyed by
         Lifnr only, no Bukrs). Three separate stat tiles — identity/Total
         accepted qty/Total lots accepted — same layout as Accepted qty/AUD
         qty, no bar chart. ═══ -->
    <VBox visible="{recon>/mdShowLotsAccepted}" class="mdPanelAnimate">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <HBox
                justifyContent="Start"
                class="mdSidebarReopenRow"
                visible="{= !${recon>/mdLeftPanelOpen} }"
            >
                <Button
                    id="mdLeftPanelMenuButtonLotsAccepted"
                    icon="sap-icon://navigation-right-arrow"
                    type="Transparent"
                    tooltip="Open"
                    class="mdSidebarGroupTitle"
                    press=".onMdLeftPanelMenuPress"
                />
            </HBox>
            <!-- <VBox
                visible="{= ${recon>/lotsAcceptedBusy} || ${recon>/lotsAcceptedItems}.length > 0 }"
                class="mdStatTile mdStatTileNeutral"
            >
                <Text
                    text="Lots Accepted"
                    class="panelSubTitle mdNoMargin textLeft"
                />
            </VBox> -->
            <VBox
                visible="{= ${recon>/lotsAcceptedBusy} || ${recon>/lotsAcceptedItems}.length > 0 }"
                class="mdStatTile mdStatTileBlue"
            >
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox alignItems="Center" class="mdStatTileContent">
                        <Text
                            text="Total Accepted Qty :"
                            class="panelSubTitle mdNoMargin textLeft"
                        />
                        <Text
                            text="{ path: 'recon>/lotsAcceptedTotal', formatter: '.formatBalanceValue' }"
                            class="panelSubValue mdNoMargin openingBalanceValue"
                        />
                    </HBox>
                    <core:Icon
                        src="sap-icon://trend-up"
                        class="mdStatIcon mdStatIconBlue"
                    />
                </HBox>
            </VBox>
            <VBox
                visible="{= ${recon>/lotsAcceptedBusy} || ${recon>/lotsAcceptedItems}.length > 0 }"
                class="mdStatTile mdStatTileGreen"
            >
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox alignItems="Center" class="mdStatTileContent">
                        <Text
                            text="Total Lots Accepted :"
                            class="panelSubTitle mdNoMargin textLeft"
                        />
                        <Text
                            text="{= ${recon>/lotsAcceptedItems}.length }"
                            class="panelSubValue mdNoMargin openingBalanceValue"
                        />
                    </HBox>
                    <core:Icon
                        src="sap-icon://list"
                        class="mdStatIcon mdStatIconGreen"
                    />
                </HBox>
            </VBox>
             <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="lotsAcceptedTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="lotsAcceptedTable" />
                    </customData>
                </Button>
            </HBox>
          
        </FlexBox>

        <IllustratedMessage
            visible="{= !${recon>/lotsAcceptedBusy} &amp;&amp; ${recon>/lotsAcceptedItems}.length === 0 }"
            illustrationType="sapIllus-NoData"
            illustrationSize="Spot"
            title="No Accepted Lots Data"
            description="{= 'No accepted lots found for ' + (${recon>/mdSupplierName} || ${recon>/mdLifnr}) + '.' }"
            class="mdNoDataIllustration"
        />

        <!-- <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
            visible="{= ${recon>/lotsAcceptedBusy} || ${recon>/lotsAcceptedItems}.length > 0 }"
        >
            <Text
                text="{= 'Lots Accepted  (' + ${recon>/lotsAcceptedItems}.length + ' records)' } "
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
            <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="lotsAcceptedTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="lotsAcceptedTable" />
                    </customData>
                </Button>
            </HBox>
        </HBox> -->

        <table:Table
            id="lotsAcceptedTable"
            width="100%"
            rowHeight="24"
            columnHeaderHeight="26"
            rows="{recon>/lotsAcceptedItems}"
            busy="{recon>/lotsAcceptedBusy}"
            busyIndicatorDelay="0"
            visible="{= ${recon>/lotsAcceptedBusy} || ${recon>/lotsAcceptedItems}.length > 0 }"
            selectionMode="None"
            enableColumnReordering="false"
            visibleRowCountMode="Auto"
            minAutoRowCount="14"
            noData="No accepted lots found."
            class="mdLineItemsTable mdGridTable"
        >
            <table:columns>
                <table:Column width="16%" sortProperty="Prueflos" filterProperty="Prueflos">
                    <table:label>
                        <Label text="Lot Number" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Prueflos}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol1" />
                    </table:customData>
                </table:Column>
                <table:Column width="10%" sortProperty="Werks" filterProperty="Werks">
                    <table:label>
                        <Label text="Plant" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Werks}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol2" />
                    </table:customData>
                </table:Column>
                <table:Column width="14%" sortProperty="Enstehdat" filterProperty="Enstehdat">
                    <table:label>
                        <Label text="Date" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{ path: 'recon>Enstehdat', formatter: '.formatOpenItemDate' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol3" />
                    </table:customData>
                </table:Column>
                <table:Column width="16%" sortProperty="Matnr" filterProperty="Matnr">
                    <table:label>
                        <Label text="Material" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Matnr}" wrapping="false" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol4" />
                    </table:customData>
                </table:Column>
                <table:Column width="14%" sortProperty="Charg" filterProperty="Charg">
                    <table:label>
                        <Label text="Batch" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Charg}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol5" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="12%"
                    hAlign="End"
                    sortProperty="Qkennzahl"
                    filterProperty="Qkennzahl"
                >
                    <table:label>
                        <Label text="Acceptance %" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Qkennzahl}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol6" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="18%"
                    hAlign="End"
                    sortProperty="Losmenge"
                    filterProperty="Losmenge"
                >
                    <table:label>
                        <Label text="Lot Quantity" design="Bold" />
                    </table:label>
                    <table:template>
                        <ObjectNumber number="{ path: 'recon>Losmenge', formatter: '.formatAmount' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="oiCol7" />
                    </table:customData>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
