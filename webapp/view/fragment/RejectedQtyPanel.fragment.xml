<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <!-- ═══ Rejected qty panel : shown in place of Line items after the
         "Rejected qty" module row (MATERIALS (MM) group) is pressed. Calls
         LotRejectSet for the current Supplier over the searched From/To Date
         range (Fromdate/Todate — LotRejectSet's own filter names, keyed by
         Lifnr only, no Bukrs), same stat-tile + table layout as Lots
         accepted/Lots received — no bar chart. ═══ -->
    <VBox visible="{recon>/mdShowRejectedQty}" class="mdPanelAnimate">
        <FlexBox
            class="mdStatTilesRow"
            wrap="Wrap"
        >
            <HBox
                justifyContent="Start"
                class="mdSidebarReopenRow"
                visible="{= !${recon>/mdLeftPanelOpen} }"
            >
                <Button
                    id="mdLeftPanelMenuButtonRejectedQty"
                    icon="sap-icon://navigation-right-arrow"
                    type="Transparent"
                    tooltip="Open"
                    class="mdSidebarGroupTitle"
                    press=".onMdLeftPanelMenuPress"
                />
            </HBox>
           
            <VBox
                visible="{= ${recon>/rejectedQtyBusy} || ${recon>/rejectedQtyItems}.length > 0 }"
                class="mdStatTile mdStatTileBlue"
            >
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox alignItems="Center" class="mdStatTileContent">
                        <Text
                            text="Total Rejected Qty :"
                            class="panelSubTitle mdNoMargin textLeft"
                        />
                        <Text
                            text="{ path: 'recon>/rejectedQtyTotal', formatter: '.formatBalanceValue' }"
                            class="panelSubValue mdNoMargin openingBalanceValue"
                        />
                    </HBox>
                    <core:Icon
                        src="sap-icon://trend-down"
                        class="mdStatIcon mdStatIconBlue"
                    />
                </HBox>
            </VBox>
            <VBox
                visible="{= ${recon>/rejectedQtyBusy} || ${recon>/rejectedQtyItems}.length > 0 }"
                class="mdStatTile mdStatTileGreen"
            >
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <HBox alignItems="Center" class="mdStatTileContent">
                        <Text
                            text="Total Lots Rejected :"
                            class="panelSubTitle mdNoMargin textLeft"
                        />
                        <Text
                            text="{= ${recon>/rejectedQtyItems}.length }"
                            class="panelSubValue mdNoMargin openingBalanceValue"
                        />
                    </HBox>
                    <core:Icon
                        src="sap-icon://list"
                        class="mdStatIcon mdStatIconGreen"
                    />
                </HBox>
            </VBox>
             <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="rejectedQtyTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="rejectedQtyTable" />
                    </customData>
                </Button>
            </HBox>
            
        </FlexBox>

        <IllustratedMessage
            visible="{= !${recon>/rejectedQtyBusy} &amp;&amp; ${recon>/rejectedQtyItems}.length === 0 }"
            illustrationType="sapIllus-NoData"
            illustrationSize="Spot"
            title="No Rejected Lots Data"
            description="{= 'No rejected lots found for ' + (${recon>/mdSupplierName} || ${recon>/mdLifnr}) + '.' }"
            class="mdNoDataIllustration"
        />
<!-- 
        <HBox
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="mdRightHeaderRow"
            visible="{= ${recon>/rejectedQtyBusy} || ${recon>/rejectedQtyItems}.length > 0 }"
        >
            <Text
                text="{= 'Rejected Qty (' + ${recon>/rejectedQtyItems}.length + ' records)' }"
                class="panelSubTitle mdLineItemsTitle mdNoMargin"
            />
            <HBox class="mdExportBtns mdLineItemsToolBtns">
                <Button
                    icon="sap-icon://action-settings"
                    text="Column Settings"
                    type="Transparent"
                    tooltip="Column Settings"
                    press=".onLineItemsColumnSettingsPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="rejectedQtyTable" />
                    </customData>
                </Button>
                <Button
                    icon="sap-icon://table-view"
                    text="Select Layout"
                    type="Transparent"
                    tooltip="Select Layout"
                    press=".onLineItemsLayoutDialogPress"
                >
                    <customData>
                        <core:CustomData key="tableId" value="rejectedQtyTable" />
                    </customData>
                </Button>
            </HBox>
        </HBox> -->

        <table:Table
            id="rejectedQtyTable"
            width="100%"
            rowHeight="24"
            columnHeaderHeight="26"
            rows="{recon>/rejectedQtyItems}"
            busy="{recon>/rejectedQtyBusy}"
            busyIndicatorDelay="0"
            visible="{= ${recon>/rejectedQtyBusy} || ${recon>/rejectedQtyItems}.length > 0 }"
            selectionMode="None"
            enableColumnReordering="false"
            visibleRowCountMode="Auto"
            minAutoRowCount="13"
            noData="No rejected lots found."
            class="mdLineItemsTable mdGridTable"
        >
            <table:columns>
                <table:Column width="16%" sortProperty="Prueflos" filterProperty="Prueflos">
                    <table:label>
                        <Label text="Lot Number" design="Bold" />
                    </table:label>
                    <table:template>
                        <Link text="{recon>Prueflos}" press=".onLotsReceivedLotNumberPress" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col1" />
                    </table:customData>
                </table:Column>
                <table:Column width="10%" sortProperty="Werks" filterProperty="Werks">
                    <table:label>
                        <Label text="Plant" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Werks}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col2" />
                    </table:customData>
                </table:Column>
                <table:Column width="14%" sortProperty="Enstehdat" filterProperty="Enstehdat">
                    <table:label>
                        <Label text="Date" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{ path: 'recon>Enstehdat', formatter: '.formatOpenItemDate' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col3" />
                    </table:customData>
                </table:Column>
                <table:Column width="16%" sortProperty="Matnr" filterProperty="Matnr">
                    <table:label>
                        <Label text="Material" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Matnr}" wrapping="false" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col4" />
                    </table:customData>
                </table:Column>
                <table:Column width="14%" sortProperty="Charg" filterProperty="Charg">
                    <table:label>
                        <Label text="Batch" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Charg}" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col6" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="12%"
                    hAlign="End"
                    sortProperty="Vcode"
                    filterProperty="Vcode"
                >
                    <table:label>
                        <Label text="Reject Code" design="Bold" />
                    </table:label>
                    <table:template>
                        <Text text="{recon>Vcode}" textAlign="End" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col7" />
                    </table:customData>
                </table:Column>
                <table:Column
                    width="18%"
                    hAlign="End"
                    sortProperty="Losmenge"
                    filterProperty="Losmenge"
                >
                    <table:label>
                        <Label text="Lot Quantity" design="Bold" />
                    </table:label>
                    <table:template>
                        <ObjectNumber number="{ path: 'recon>Losmenge', formatter: '.formatAmount' }" />
                    </table:template>
                    <table:customData>
                        <core:CustomData key="colId" value="col8" />
                    </table:customData>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
