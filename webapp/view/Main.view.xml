<mvc:View
    controllerName="supplieropenitems.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    displayBlock="true"
    xmlns="sap.m"
>
    <!-- ═══ Plain sap.m.Page instead of sap.f.DynamicPage — DynamicPage
         reserves header/scroll chrome this view never uses (no f:header,
         no collapsible title band), which was just adding dead space above
         the dashboard card. ═══ -->
    <Page
        id="dynamicPage"
        showHeader="false"
        showFooter="false"
    >
        <!-- ═══════════════ CONTENT : DASHBOARD CARD ═══════════════ -->
        <content>
            <Panel
                id="mainContentPanel"
                expandable="false"
                expanded="true"
                class="sapUiNoContentPadding"
                height="100%"
                width="100%"
            >
                <!-- ═══ Panel Header Toolbar: filter bar, then tab navigation ═══ -->
                <headerToolbar>
                    <Toolbar
                        height="auto"
                        class="dashboardHeaderToolbar"
                    >
                        <VBox width="100%">
                            <core:Fragment
                                fragmentName="supplieropenitems.view.fragment.FilterBar"
                                type="XML"
                            />

                            <!-- ═══ Chart / Vendors / Vendor history tabs ═══ -->
                            <!-- ═══ Chart / Vendors / Vendor history tabs ═══ -->
<IconTabHeader
    id="idIconTabBarNoIcons"
    class="sapUiResponsiveContentPadding"
    select=".onTabSelect"
    mode="Inline"
    visible="{= ${recon>/count} > 0 &amp;&amp; !${recon>/masterDetailMode} }"
>
    <items>
        <IconTabFilter
            key="chart"
            text="Chart"
        />

        <IconTabFilter
            key="vendors"
           text="{= ${recon>/selectedCategory} ? ${recon>/selectedCategory} : '' }"
            visible="{= !!${recon>/selectedCategory} }"
        />
        
        	



        <!-- <IconTabFilter
            key="kpi"
            text="Vendor History"
            visible="{= !!${recon>/selectedVendor} }"
        /> -->
    </items>
</IconTabHeader>

<!-- Selected category + loading indicator -->
<!-- <HBox
    alignItems="Center"
    class="vendorsForHeading"
    visible="{= !!${recon>/selectedCategory} }"
>
    <Text
        text="{= ${recon>/selectedCategory} ? ${recon>/selectedCategory} : '' }"
        class="panelSubTitle"
    />

    <BusyIndicator
        visible="{recon>/vendorsBusy}"
        size="0.75rem"
        class="sapUiTinyMarginBegin"
    />
</HBox> -->
                        </VBox>
                    </Toolbar>
                </headerToolbar>

                <ScrollContainer
                    id="mainScrollContainer"
                    vertical="true"
                    horizontal="false"
                    height="100%"
                    width="100%"
                >
                    <VBox
                        id="contentWrapper"
                        class="contentWrapperFixed"
                    >
                        <BusyIndicator
                            visible="{recon>/busy}"
                            size="2rem"
                            class="sapUiLargeMarginTop"
                        />

                        <IllustratedMessage
                            visible="{= !${recon>/busy} &amp;&amp; ${recon>/count} === 0 &amp;&amp; !${recon>/masterDetailMode}}"
                            illustrationType="sapIllus-NoData"
                            title="No data yet"
                            description="Enter a Company Code and Key Date, then choose Go."
                        />

                        <!-- ═══ Master-Detail Panel : shown when a Supplier is entered — Opening
                             balance summary + line items (real data), "Modules" lives in its header ═══ -->

                        <VBox
                            visible="{= !${recon>/busy} &amp;&amp; ${recon>/count} > 0 &amp;&amp; !${recon>/masterDetailMode}}"
                            class="dashboardCard"
                        >
                            <!-- ═══ Chart Tab Content ═══ -->
                            <VBox
                                id="chartContent"
                                visible="true"
                                class="tabScrollArea"
                            >
                                <f:GridContainer
                                    id="dashboardGrid"
                                    class="dashboardGrid"
                                    containerQuery="true"
                                    snapToRow="true"
                                >
                                    <f:layout>
                                        <f:GridContainerSettings
                                            rowSize="2rem"
                                            columnSize="5rem"
                                            gap="0.1rem"
                                        />
                                    </f:layout>
                                    <VBox
                                        class="topCategoriesPanel dashPanelBox"
                                    >
                                        <layoutData>
                                            <f:GridContainerItemLayoutData
                                                columns="5"
                                                rows="12"
                                            />
                                        </layoutData>
                                        <Text
                                            text="Top Categories by Net Amount"
                                            class="panelSubTitle"
                                        />
                                        <VBox class="topCategoriesNamesBox">
                                            <core:HTML
                                                id="topCategoriesNamesHtml"
                                                content="&lt;div id='topCategoriesNamesContainer' class='topCategoriesNamesContainer'&gt;&lt;/div&gt;"
                                            />
                                        </VBox>
                                        <HBox
                                            alignItems="Center"
                                            class="noteBox"
                                        >
                                            <core:Icon
                                                src="sap-icon://information"
                                                class="noteIcon"
                                            />
                                            <Text
                                                text="Note: Negative values represent returns or deductions"
                                                class="noteText"
                                            />
                                        </HBox>
                                    </VBox>

                                    <VBox class="donutPanel dashPanelBox">
                                        <layoutData>
                                            <f:GridContainerItemLayoutData
                                                columns="5"
                                                rows="12"
                                            />
                                        </layoutData>
                                        <Text
                                            text="Net Amount Distribution"
                                            class="panelSubTitle"
                                        />
                                        <HBox
                                            class="donutAndLegend"
                                            justifyContent="Center"
                                        >
                                            <core:HTML
                                                id="donutSvgHtml"
                                                content="&lt;div id='donutSvgContainer' class='donutSvgContainer'&gt;&lt;/div&gt;"
                                                afterRendering=".onDonutHtmlRendered"
                                            />
                                        </HBox>
                                        <HBox
                                            alignItems="Center"
                                            class="noteBox"
                                        >
                                            <core:Icon
                                                src="sap-icon://information"
                                                class="noteIcon"
                                            />
                                            <Text
                                                text="Note: Negative values represent returns or deductions"
                                                class="noteText"
                                            />
                                        </HBox>
                                    </VBox>

                                    <VBox
                                        class="advanceSummaryPanel dashPanelBox"
                                    >
                                        <layoutData>
                                            <f:GridContainerItemLayoutData
                                                columns="2"
                                                rows="12"
                                            />
                                        </layoutData>
                                        <Text
                                            text="Totals"
                                            class="panelSubTitle"
                                        />
                                        <VBox
                                            class="advanceStatTile advanceStatTileActive"
                                        >
                                            <HBox
                                                alignItems="Center"
                                                class="advanceStatHeader"
                                            >
                                                <VBox
                                                    class="advanceStatIcon advanceStatIconGreen"
                                                >
                                                    <Text
                                                        text="&#931;"
                                                        class="advanceStatIconSigma"
                                                    />
                                                </VBox>
                                                <Text
                                                    text="Net Amount"
                                                    class="advanceStatLabel"
                                                />
                                            </HBox>
                                            <Text
                                                text="{ path: 'recon>/totals/netAmt', formatter: '.formatAmount' }"
                                                class="advanceStatValue"
                                            />
                                        </VBox>
                                        <VBox class="advanceStatTile">
                                            <HBox
                                                alignItems="Center"
                                                class="advanceStatHeader"
                                            >
                                                <VBox
                                                    class="advanceStatIcon advanceStatIconBlue"
                                                >
                                                    <core:Icon
                                                        src="sap-icon://receipt"
                                                    />
                                                </VBox>
                                                <Text
                                                    text="Invoice Amount"
                                                    class="advanceStatLabel"
                                                />
                                            </HBox>
                                            <Text
                                                text="{ path: 'recon>/totals/invAmt', formatter: '.formatAmount' }"
                                                class="advanceStatValue"
                                            />
                                        </VBox>
                                        <VBox class="advanceStatTile">
                                            <HBox
                                                alignItems="Center"
                                                class="advanceStatHeader"
                                            >
                                                <VBox
                                                    class="advanceStatIcon advanceStatIconOrange"
                                                >
                                                    <core:Icon
                                                        src="sap-icon://wallet"
                                                    />
                                                </VBox>
                                                <Text
                                                    text="Advance Amount"
                                                    class="advanceStatLabel"
                                                />
                                            </HBox>
                                            <Text
                                                text="{ path: 'recon>/totals/advAmt', formatter: '.formatAmount' }"
                                                class="advanceStatValue"
                                            />
                                        </VBox>
                                    </VBox>
                                </f:GridContainer>
                            </VBox>

                            <!-- ═══ Vendors Tab Content ═══ -->
                            <VBox
                                id="vendorsContent"
                                visible="false"
                                class="tabScrollArea vendorsTableWrapper"
                            >
                                <!-- <Text
                                    text="{= ${recon>/selectedCategory} ? '' + ${recon>/selectedCategory} : '' }"
                                    visible="{= !!${recon>/selectedCategory} }"
                                    class="panelSubTitle vendorsForHeading"
                                />
                                <BusyIndicator
                                    visible="{recon>/vendorsBusy}"
                                    size="1.5rem"
                                    class="sapUiSmallMarginTop"
                                /> -->
                                <!-- ═══ SAP grid table (sap.ui.table.Table) : column headers are
                                     fixed by the control itself while rows scroll underneath —
                                     same treatment as every other line-items table on this page,
                                     instead of sap.m.Table's sticky="ColumnHeaders" CSS hack. ═══ -->
                                <table:Table
                                    id="vendorsTable"
                                    width="100%"
                                    rowHeight="30"
                                    rows="{recon>/items}"
                                    busy="{recon>/vendorsBusy}"
                                    busyIndicatorDelay="0"
                                    selectionMode="None"
                                    enableColumnReordering="false"
                                    visibleRowCountMode="Fixed"
                                    visibleRowCount="10"
                                    noData="No vendor items found."
                                    class="mdLineItemsTable mdGridTable"
                                    cellClick=".onVendorItemPress"
                                    sort=".onVendorsTableSort"
                                >
                                    <table:columns>
                                        <!-- ═══ Percentage widths (summing to 100%) instead of fixed
                                             rem so this table always stretches to fill its container's
                                             full width, on any screen size, same as the master-detail
                                             line-items tables. ═══ -->
                                        <table:Column width="12%" sortProperty="Lifnr" filterProperty="Lifnr">
                                            <table:label>
                                                <Label text="Supplier" design="Bold" />
                                            </table:label>
                                            <table:template>
                                                <Text text="{recon>Lifnr}" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="20%" sortProperty="Name1" filterProperty="Name1">
                                            <table:label>
                                                <Label text="Name" design="Bold" />
                                            </table:label>
                                            <table:template>
                                                <Text text="{recon>Name1}" />
                                            </table:template>
                                        </table:Column>
                                      
<table:Column width="14%" hAlign="End" sortProperty="InvAmt" filterProperty="InvAmt">
    <table:label>
        <Label text="Closing Bal. Amt" design="Bold" />
    </table:label>
    <table:template>
        <ObjectStatus
            text="₹ { path: 'recon>InvAmt', formatter: '.formatAmount' }"
            inverted="true"
            state="{= Number(${recon>InvAmt}) >= 100 ? 'Indication04' : 'Indication02' }"
        />
    </table:template>
</table:Column>  


                                        <table:Column width="14%" hAlign="End" sortProperty="AdvAmt" filterProperty="AdvAmt">
                                            <table:label>
                                                <Label text="Net Adv. Amt" design="Bold" />
                                            </table:label>
                                            <table:template>
                                                <Text
    text="₹ { path: 'recon>AdvAmt', formatter: '.formatAmount' }"
/>
                                            </table:template>
                                        </table:Column>
                                        <!-- <table:Column width="14%" hAlign="End">
                                            <table:label>
                                                <Label text="Net Amt" design="Bold" />
                                            </table:label>
                                            <table:template>
                                                <ObjectNumber number="{ path: 'recon>NetAmt', formatter: '.formatAmount' }" />
                                            </table:template>
                                        </table:Column> -->
                                        <table:Column width="13%" hAlign="End" sortProperty="TrgMenge" filterProperty="TrgMenge">
                                            <table:label>
                                                <Label text="Contracts Qty Bal." design="Bold" />
                                            </table:label>
                                            <table:template>
                                                <Text text="₹ { path: 'recon>TrgMenge', formatter: '.formatAmount' }" textAlign="End" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="13%" hAlign="End" sortProperty="TrgNetpr" filterProperty="TrgNetpr">
                                            <table:label>
                                                <Label text="Qty Balance Amt." design="Bold" />
                                            </table:label>
                                            <table:template>
                                                <Text text="₹ {recon>TrgNetpr}  " textAlign="End" />
                                            </table:template>
                                        </table:Column>
                                    </table:columns>
                                </table:Table>
                            </VBox>

                            <!-- ═══ Open Items (KPI) Tab Content ═══ -->
                            <VBox
                                id="kpiContent"
                                visible="false"
                                class="tabScrollArea vendorsTableWrapper"
                            >
                                <BusyIndicator
                                    visible="{recon>/openItemsBusy}"
                                    size="1.5rem"
                                    class="sapUiSmallMarginTop"
                                />
                                <FlexBox
                                    class="kpiTilesRow"
                                    fitContainer="true"
                                    wrap="Wrap"
                                >
                                    <GenericTile
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom openItemsGenericTile"
                                        header="RE Documents"
                                        subheader="{= ${recon>/kpiTiles/re/count} + ' document(s)' }"
                                        frameType="TwoByOne"
                                        press=".onOpenItemsTilePress"
                                    >
                                        <customData>
                                            <core:CustomData
                                                key="docType"
                                                value="RE"
                                            />
                                        </customData>
                                        <tileContent>
                                            <TileContent
                                                unit="INR"
                                                footer="{ path: 'recon>/kpiTiles/re/invAmt', formatter: '.formatInvoiceFooter' }"
                                            >
                                                <NumericContent
                                                    value="{ path: 'recon>/kpiTiles/re/netAmt', formatter: '.formatCompactAmount' }"
                                                    scale="{ path: 'recon>/kpiTiles/re/netAmt', formatter: '.formatCompactScale' }"
                                                    icon="sap-icon://receipt"
                                                    valueColor="{ path: 'recon>/kpiTiles/re/netAmt', formatter: '.formatValueColor' }"
                                                    indicator="{ path: 'recon>/kpiTiles/re/netAmt', formatter: '.formatIndicator' }"
                                                    withMargin="false"
                                                />
                                            </TileContent>
                                        </tileContent>
                                    </GenericTile>

                                    <GenericTile
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom openItemsGenericTile"
                                        header="Non-RE Documents"
                                        subheader="{= ${recon>/kpiTiles/other/count} + ' document(s)' }"
                                        frameType="TwoByOne"
                                        press=".onOpenItemsTilePress"
                                    >
                                        <customData>
                                            <core:CustomData
                                                key="docType"
                                                value="OTHER"
                                            />
                                        </customData>
                                        <tileContent>
                                            <TileContent
                                                unit="INR"
                                                footer="{ path: 'recon>/kpiTiles/other/invAmt', formatter: '.formatInvoiceFooter' }"
                                            >
                                                <NumericContent
                                                    value="{ path: 'recon>/kpiTiles/other/netAmt', formatter: '.formatCompactAmount' }"
                                                    scale="{ path: 'recon>/kpiTiles/other/netAmt', formatter: '.formatCompactScale' }"
                                                    icon="sap-icon://documents"
                                                    valueColor="{ path: 'recon>/kpiTiles/other/netAmt', formatter: '.formatValueColor' }"
                                                    indicator="{ path: 'recon>/kpiTiles/other/netAmt', formatter: '.formatIndicator' }"
                                                    withMargin="false"
                                                />
                                            </TileContent>
                                        </tileContent>
                                    </GenericTile>
                                </FlexBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollContainer>
            </Panel>
        </content>
    </Page>
</mvc:View>
