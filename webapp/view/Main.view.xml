<mvc:View
    controllerName="supplieropenitems.controller.Main"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
>
    <f:DynamicPage
        id="dynamicPage"
        headerExpanded="true"
        preserveHeaderStateOnScroll="true"
        showFooter="true"
        fitContent="true"
    >
        <!-- ── TITLE ── -->
