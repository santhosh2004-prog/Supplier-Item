<mvc:View
    controllerName="supplieropenitems.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    displayBlock="true"
    xmlns="sap.m"
>
    <!-- ═══ Dedicated Supplier Open Items (master-detail) page, reached via
         router navTo("Routedetail", {...}) from Main.controller.js's onSearch
         whenever a Supplier is entered. Same filter bar (shared fragment),
         same FINANCE/MATERIALS/QUALITY sidebar + panel fragments, same
         recon model bindings as this content used to have inline in
         Main.view.xml under masterDetailMode=true — only the container
         changed, everything else (fragments, controller logic, formatters)
         is untouched. See Detail.controller.js. ═══ -->
    <Page
        id="detailPage"
        showHeader="false"
        showFooter="false"
    >
        <content>
            <Panel
                id="detailContentPanel"
                expandable="false"
                expanded="true"
                class="sapUiNoContentPadding"
                height="100%"
                width="100%"
            >
                <headerToolbar>
                    <Toolbar
                        height="auto"
                        class="dashboardHeaderToolbar"
                    >
                        <VBox width="100%">
                            <core:Fragment
                                fragmentName="supplieropenitems.view.fragment.FilterBar"
                                type="XML"
                            />
                        </VBox>
                    </Toolbar>
                </headerToolbar>

                <!-- vertical="true" as a SAFETY NET, not the primary
                     scroller: mdSidebarPanel/mdRightContentArea are each
                     their own fixed-height (.mdLayoutRow's calc(100vh -
                     7rem)), independently-scrolling box, so in the normal
                     case this outer container never has anything to
                     scroll (its content already fits within height="100%")
                     and stays inert. It only engages if that 7rem guess is
                     ever still too generous for a particular browser
                     chrome/zoom/window size — catching the leftover
                     overflow instead of silently clipping content with
                     nothing left to scroll into, which is what happened
                     with this set to "false": once .mdLayoutRow's height
                     didn't perfectly match the real available space, the
                     tail of the sidebar list rendered below the visible
                     window with no scroller anywhere able to reach it. A
                     small risk of the two columns' scroll looking "linked"
                     in that rare fallback case is a fair trade for content
                     never being permanently unreachable. -->
               
                    <VBox
                        id="detailContentWrapper"
                        class="contentWrapperFixed"
                    >
                        <BusyIndicator
                            visible="{recon>/busy}"
                            size="2rem"
                            class="sapUiLargeMarginTop"
                        />

                        <VBox
                            id="masterDetailCard"
                            visible="{= !${recon>/busy} &amp;&amp; ${recon>/masterDetailMode}}"
                            class="mdRightPanel mdRightPanelFullWidth dashPanelBox"
                        >
                            <HBox
                                id="mdLayoutRow"
                                class="mdLayoutRow"
                                alignItems="Stretch"
                            >
                                <!-- ═══ Docked "Modules" sidebar — Gmail-style: pinned open by
                                     default, the "Modules" button collapses/expands it in place
                                     instead of floating a popover, so the panel on the right
                                     (chart + line items) reflows to fill the freed width. ═══ -->
                                <VBox
                                    id="mdSidebarPanel"
                                    visible="{recon>/mdLeftPanelOpen}"
                                    class="mdSidebarPanel"
                                >
                                    <HBox
                                        justifyContent="SpaceBetween"
                                        alignItems="Center"
                                        class="mdSidebarHeaderRow sapUiSizeCompact"
                                    >
                                        
                                    </HBox>
                                    <List
                                        showSeparators="None"
                                        class="modulesList"
                                    >
                                        <CustomListItem class="mdSidebarGroupHeaderLI">
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarGroupBanner mdBannerBlue"
                                            >
                                                <Text
                                                    text="FINANCE (FI)"
                                                    class="mdSidebarGroupTitle"
                                                />
                                                <Button
                                            icon="sap-icon://navigation-left-arrow"
                                            type="Transparent"
                                            tooltip="Close"
                                            class='mdSidebarGroupTitle'
                                            press=".onMdLeftPanelMenuPress"
                                        />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem
                                            type="Active"
                                            press=".onOpeningBalancePress"
                                            class="mdSidebarRowLI"
                                        >
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Opening Balance"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/openingBalanceValue', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem
                                            type="Active"
                                            press=".onTransactionsPress"
                                            class="mdSidebarRowLI"
                                        >
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Transactions"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/transactionsTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem
                                            type="Active"
                                            press=".onAdvanceBalancePress"
                                            class="mdSidebarRowLI"
                                        >
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Advance Balance"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/advanceTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem
                                            type="Active"
                                            press=".onDebitNotesPress"
                                            class="mdSidebarRowLI"
                                        >
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Debit Notes"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/debitNotesTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem
                                            type="Active"
                                            press=".onModuleRowPress"
                                            class="mdSidebarRowLI"
                                        >
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Credit notes" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Credit Notes"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem
                                            type="Active"
                                            press=".onPaymentsRowPress"
                                            class="mdSidebarRowLI"
                                        >
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Payments"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/paymentsTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>

                                        </CustomListItem>
                                        <CustomListItem
                                            type="Active"
                                            press=".onPendingInvoicesPress"
                                            class="mdSidebarRowLI"
                                        >
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Pending Invoices"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/pendingInvoicesTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem class="mdSidebarGroupHeaderLI">
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarGroupBanner mdBannerAmber"
                                            >
                                                <Text
                                                    text="MATERIALS (MM)"
                                                    class="mdSidebarGroupTitle"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        

                                        <CustomListItem type="Active" press=".onTotalPOPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Total PO value" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Total PO Value"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                     text="{ path: 'recon>/totalPOTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem type="Active" press=".onPendingPOPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Pending PO" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Pending PO"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/pendingPOTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem type="Active" press=".onMaterialReceiptsPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Material receipts" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Material Receipts"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/matReceiptsTotal', formatter: '.formatSidebarAmount' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem type="Active" press=".onVendorReturnsPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Vendor returns" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Vendor Returns"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{= ${recon>/vendorReturnsCount} + ' items' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        

                                        <CustomListItem type="Active" press=".onShareOfBusinessPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Share of business" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Share of Business"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{ path: 'recon>/shareOfBusinessQtyPercent', formatter: '.formatShareOfBusinessSidebarValue' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem class="mdSidebarGroupHeaderLI">
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarGroupBanner mdBannerPurple"
                                            >
                                                <Text
                                                    text="QUALITY (QM)"
                                                    class="mdSidebarGroupTitle"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem type="Active" press=".onLotsReceivedPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Lots received" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Lots Received"
                                                        class="mdSidebarRowLabel"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{= ${recon>/lotsReceivedCount} + ' lots' }"
                                                    class="mdSidebarRowValue"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem type="Active" press=".onLotsAcceptedPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Lots accepted" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Lots Accepted "
                                                        class="mdSidebarRowLabel "
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{= ${recon>/lotsAcceptedCount} + ' lots' }"
                                                    class="mdSidebarRowValue "
                                                />
                                            </HBox>
                                        </CustomListItem>
                                        <CustomListItem type="Active" press=".onAcceptedQtyPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Accepted qty" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Accepted Qty"
                                                        class="mdSidebarRowLabel mdSidebarRowLabelGreen"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{= ${recon>/acceptedQtyCount} + ' lots' }"
                                                    class="mdSidebarRowLabel mdSidebarRowLabelGreen"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem type="Active" press=".onRejectedQtyPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="Rejected qty" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="Rejected Qty"
                                                        class="mdSidebarRowLabel mdSidebarRowLabelRed"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{= ${recon>/rejectedQtyCount} + ' lots' }"
                                                    class="mdSidebarRowLabel mdSidebarRowLabelRed"
                                                />
                                            </HBox>
                                        </CustomListItem>

                                        <CustomListItem type="Active" press=".onAudQtyPress" class="mdSidebarRowLI">
                                            <customData>
                                                <core:CustomData key="moduleLabel" value="AUD qty" />
                                            </customData>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="mdSidebarRowInner"
                                            >
                                                <HBox
                                                    alignItems="Center"
                                                    class="mdSidebarRowLeft"
                                                >
                                                    <Text
                                                        text="AUD Qty"
                                                        class="mdSidebarRowLabel mdSidebarRowLabelBlue"
                                                    />
                                                </HBox>
                                                <Text
                                                    text="{= ${recon>/audQtyCount} + ' lots' }"
                                                    class="mdSidebarRowLabel mdSidebarRowLabelBlue"
                                                />
                                            </HBox>
                                        </CustomListItem>
                                    </List>
                                </VBox>

                                <VBox
                                    id="mdRightContentArea"
                                    class="mdRightContentArea"
                                >
                                    <!-- Reopen button for the docked "Modules" sidebar — only
                                         thing rendered when the panel is closed, since the
                                         close button lives inside the panel itself. -->
                                    <!-- <HBox
                                        justifyContent="Start"
                                        class="mdSidebarReopenRow"
                                        visible="{= !${recon>/mdLeftPanelOpen} }"
                                    >
                                        <Button
                                            id="mdLeftPanelMenuButton"
                                            icon="sap-icon://navigation-right-arrow"
                                            type="Transparent"
                                            tooltip="Open"
                                            class="mdSidebarGroupTitle"
                                            press=".onMdLeftPanelMenuPress"
                                        />
                                    </HBox> -->

                                    <!-- <HBox
                                        justifyContent="SpaceBetween"
                                        alignItems="Center"
                                        class="mdRightHeaderRow"
                                    >
                                        <HBox
                                            alignItems="Center"
                                            class="mdRightHeaderTitleRow"
                                        >
                                            <Button
                                                id="mdLeftPanelMenuButton"
                                                text="Modules"
                                                icon="sap-icon://navigation-right-arrow"
                                                press=".onMdLeftPanelMenuPress"
                                                visible="{= !${recon>/mdLeftPanelOpen} }"
                                                ariaHasPopup="Menu"
                                            />
                                            <Text
                                                text="{= ${recon>/mdShowGenericModule} ? ${recon>/mdGenericModuleLabel} : ( ${recon>/mdShowTransactions} ? 'Transactions' : ( ${recon>/mdShowAdvance} ? 'Advance balance' : ( ${recon>/mdShowDebitNotes} ? 'Debit notes' : ( ${recon>/mdShowPayments} ? 'Payments' : 'Opening balance' ) ) ) ) }"
                                                class="panelSubTitle mdNoMargin"
                                            />
                                        </HBox>
                                        <HBox class="mdExportBtns">
                                            <Button
                                                icon="sap-icon://refresh"
                                                type="Transparent"
                                                tooltip="Refresh"
                                                press=".onRefreshMasterDetail"
                                            />
                                            <Button
                                                icon="sap-icon://nav-back"
                                                type="Success"
                                                tooltip="Back to Chart"
                                                press=".onBackToChart"
                                            />
                                        </HBox>
                                    </HBox> -->

                                    <!-- ═══ Each right-panel section now lives in its own fragment — same
                                         model, same visible-flag bindings, just organized as separate
                                         files instead of one long inline block. ═══ -->
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.GenericModulePanel"
                                        type="XML"
                                    />
                                  
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.OpenItemsPanel"
                                        type="XML"
                                    />
                                     
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.AdvanceBalancePanel"
                                        type="XML"
                                    />
                                     
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.DebitNotesPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.PaymentsPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.TransactionsPanel"
                                        type="XML"
                                    />
                                     <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.Pendinginvoices"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.TotalPOPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.PendingPOPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.LotsAcceptedPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.AcceptedQtyPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.LotsReceivedPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.RejectedQtyPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.AudQtyPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.ShareOfBusinessPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.MatReceiptPanel"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="supplieropenitems.view.fragment.VendorReturnsPanel"
                                        type="XML"
                                    />




                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
             
            </Panel>
        </content>
    </Page>
</mvc:View>
